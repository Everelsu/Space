<Window x:Class="Space.TasksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpaceZ — Работники" Height="650" Width="1100"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Border Background="#111827" CornerRadius="12" Margin="8">
        <Border.Effect><DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.5"/></Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Background="#0B1120" MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0" Width="92">
                    <TextBlock Text="Space" FontSize="16" FontWeight="Bold" Foreground="White"
                   VerticalAlignment="Center" Margin="4,0,-4,0"/>
                    <Image Source="/Assets/Z.png" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top"
               Margin="0,-2,-10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button Content="─" Style="{StaticResource TitleBtnStyle}" Click="Minimize_Click"/>
                    <Button Content="✕" Style="{StaticResource TitleBtnStyle}" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- Body -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="195"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0" Background="#0B1120" CornerRadius="0,0,0,12">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Margin="8,0,8,12">
                            <Separator Background="#1E293B" Margin="4,0,4,8" Height="1"/>
                            <Button Content="⬅  Выход" Style="{StaticResource NavBtnStyle}"
                                    Foreground="#EF4444" Click="Exit_Click"/>
                        </StackPanel>
                        <Border DockPanel.Dock="Top" Background="#0D1629" Margin="8,12,8,4"
                                Padding="12,10" CornerRadius="8">
                            <StackPanel>
                                <TextBlock x:Name="SidebarRole"     Style="{StaticResource UserRoleStyle}"/>
                                <TextBlock x:Name="SidebarUsername" Style="{StaticResource UserNameStyle}"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Margin="8,8,8,0">
                            <TextBlock Text="НАВИГАЦИЯ" Style="{StaticResource NavSectionLabel}"/>
                            <Button Content="📁  Проекты"   Style="{StaticResource NavBtnStyle}"    Click="NavProjects_Click"/>
                            <Button Content="👥  Работники" Style="{StaticResource NavBtnActiveStyle}"/>
                            <Button Content="🏷  Команды"   Style="{StaticResource NavBtnStyle}"    Click="NavTeams_Click"/>
                            <Button Content="📋  Задания"   Style="{StaticResource NavBtnStyle}"    Click="NavTasks_Click"/>
                            <Button Content="📝  Отчёты"    Style="{StaticResource NavBtnStyle}"    Click="NavReports_Click"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Content -->
                <Grid Grid.Column="1" Margin="24,18,24,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Page header with counter -->
                    <Grid Grid.Row="0" Margin="0,0,0,2">
                        <StackPanel>
                            <TextBlock Text="Работники" Style="{StaticResource PageTitleStyle}"/>
                            <TextBlock Text="Список сотрудников и управление доступом" Style="{StaticResource PageSubtitleStyle}"/>
                        </StackPanel>
                        <TextBlock x:Name="CountLabel" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                   Foreground="#4B5563" FontSize="12" Margin="0,0,0,4"/>
                    </Grid>

                    <!-- Toolbar: Search + Role filter + Add -->
                    <Grid Grid.Row="1" Margin="0,12,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" Style="{StaticResource SearchBoxStyle}"
                                 Text="🔍  Поиск..." GotFocus="Search_GotFocus" LostFocus="Search_LostFocus"
                                 TextChanged="Search_TextChanged"/>
                        <ComboBox Grid.Column="2" x:Name="FilterRole" Height="36"
                                  Style="{StaticResource FormComboStyle}"
                                  SelectionChanged="Filter_Changed">
                            <ComboBoxItem Content="Все роли"  Tag="" IsSelected="True"/>
                            <ComboBoxItem Content="Developer" Tag="developer"/>
                            <ComboBoxItem Content="Tester"    Tag="tester"/>
                            <ComboBoxItem Content="Manager"   Tag="manager"/>
                        </ComboBox>
                        <Button Grid.Column="4" Content="+ Добавить" Style="{StaticResource PrimaryBtnStyle}"
                                Click="AddBtn_Click"/>
                    </Grid>

                    <!-- Add / Edit form -->
                    <Border Grid.Row="2" x:Name="AddPanel" Visibility="Collapsed"
                            Background="#1E293B" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock x:Name="FormTitle" Text="Новый работник" Foreground="White" FontSize="13"
                                       FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <!-- Row 1: FullName, Email, Position, Role -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="AddFullName" Style="{StaticResource FormInputStyle}" Tag="Имя Фамилия"/>
                                <TextBox Grid.Column="2" x:Name="AddEmail"    Style="{StaticResource FormInputStyle}" Tag="Email"/>
                                <TextBox Grid.Column="4" x:Name="AddPosition" Style="{StaticResource FormInputStyle}" Tag="Должность"/>
                                <ComboBox Grid.Column="6" x:Name="AddRole"    Style="{StaticResource FormComboStyle}">
                                    <ComboBoxItem Content="Разработчик" Tag="developer" IsSelected="True"/>
                                    <ComboBoxItem Content="Тестировщик" Tag="tester"/>
                                    <ComboBoxItem Content="Менеджер"    Tag="manager"/>
                                </ComboBox>
                            </Grid>
                            <!-- Row 2: Username, Password, Save (only shown when adding new) -->
                            <Grid x:Name="LoginRow" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="AddUsername" Style="{StaticResource FormInputStyle}" Tag="Логин"/>
                                <TextBox Grid.Column="2" x:Name="AddPassword" Style="{StaticResource FormInputStyle}" Tag="Пароль"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Right">
                                <TextBlock x:Name="AddError" Foreground="#F87171" FontSize="11"
                                           VerticalAlignment="Center" Margin="0,0,10,0" Visibility="Collapsed"/>
                                <Button x:Name="SaveBtn" Content="Сохранить" Style="{StaticResource PrimaryBtnStyle}" Click="SaveAdd_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="3" x:Name="Grid" Style="{StaticResource GridStyle}"
                              ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                              CellStyle="{StaticResource GridCellStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"        Binding="{Binding Id}"        Width="40"/>
                            <DataGridTextColumn Header="Имя"       Binding="{Binding FullName}"   Width="*"/>
                            <DataGridTextColumn Header="Должность" Binding="{Binding Position}"   Width="115"/>
                            <DataGridTextColumn Header="Email"     Binding="{Binding Email}"      Width="140"/>
                            <DataGridTextColumn Header="Команда"   Binding="{Binding Team}"       Width="90"/>
                            <DataGridTextColumn Header="Логин"     Binding="{Binding Username}"   Width="95"/>
                            <DataGridTextColumn Header="Роль"      Binding="{Binding RoleLabel}"  Width="105"/>
                            <DataGridTemplateColumn Header="Действия" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="✏ Изменить" Style="{StaticResource EditBtnStyle}"
                                                    Tag="{Binding Id}" Click="Edit_Click" Margin="0,0,4,0"/>
                                            <Button Content="Удалить" Style="{StaticResource DangerBtnStyle}"
                                                    Tag="{Binding Id}" Click="Delete_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
