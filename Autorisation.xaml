<Window x:Class="Space.Autorisation"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpaceZ"
        Height="480" Width="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Window.Resources>

        <Style x:Key="InputStyle" TargetType="Control">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource InputStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#7B3FE4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="PasswordBox" BasedOn="{StaticResource InputStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#7B3FE4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#7B3FE4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#9D5CFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#6D28D9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#4B2C8A"/>
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- Outer shadow border -->
    <Border Background="#0F172A"
            CornerRadius="16"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom title bar -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                <Button Content="✕"
                        Width="32" Height="32"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0"
                        FontSize="12"
                        Click="CloseButton_Click"/>
            </Grid>

            <!-- Content -->
            <Border Grid.Row="1"
                    Padding="36,16,36,36">
                <StackPanel VerticalAlignment="Center">

                    <!-- Logo / Title -->
                    <Grid HorizontalAlignment="Center" Margin="0,0,0,4">
                        <TextBlock Text="Space"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   VerticalAlignment="Center" Margin="-18,0,18,0"/>
                        <Image Source="/Assets/Z.png"
                               Height="36"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Margin="0,-3,-56,0"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>

                    <TextBlock Text="Войдите в свой аккаунт"
                               FontSize="13"
                               Foreground="#6B7280"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,28"/>

                    <!-- Login -->
                    <TextBlock Text="Логин"
                               Foreground="#9CA3AF"
                               FontSize="12"
                               Margin="0,0,0,6"/>
                    <TextBox x:Name="LoginBox" Margin="0,0,0,16"/>

                    <!-- Password -->
                    <TextBlock Text="Пароль"
                               Foreground="#9CA3AF"
                               FontSize="12"
                               Margin="0,0,0,6"/>
                    <PasswordBox x:Name="PasswordInput" Margin="0,0,0,8"/>

                    <!-- Error -->
                    <TextBlock x:Name="ErrorText"
                               Foreground="#F87171"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"
                               Visibility="Collapsed"/>

                    <!-- Submit -->
                    <Button x:Name="LoginButton"
                            Content="Войти"
                            Margin="0,8,0,0"
                            Click="Button_Click"/>

                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
