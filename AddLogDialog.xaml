<Window x:Class="Space.AddLogDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить отчёт"
        Height="300" Width="380"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Border Background="#111827" CornerRadius="12" Margin="8">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="0" Opacity="0.5"/>
        </Border.Effect>
        <StackPanel Margin="24">

            <TextBlock x:Name="TaskTitleText"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="White" TextWrapping="Wrap"
                       Margin="0,0,0,16"/>

            <TextBlock Text="Часы" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,6"/>
            <TextBox x:Name="HoursBox"
                     Background="#1E293B" Foreground="White"
                     BorderBrush="#334155" BorderThickness="1"
                     Padding="10,8" FontSize="13"
                     Text="1"/>

            <TextBlock Text="Комментарий" Foreground="#9CA3AF" FontSize="12" Margin="0,12,0,6"/>
            <TextBox x:Name="CommentBox"
                     Background="#1E293B" Foreground="White"
                     BorderBrush="#334155" BorderThickness="1"
                     Padding="10,8" FontSize="13"
                     Height="60" TextWrapping="Wrap"
                     AcceptsReturn="True"/>

            <TextBlock x:Name="ErrorText" Foreground="#F87171" FontSize="12"
                       Margin="0,8,0,0" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Отмена" Width="80" Height="34"
                        Background="#1E293B" Foreground="#9CA3AF"
                        BorderThickness="0" Cursor="Hand"
                        Click="Cancel_Click"/>
                <Button Content="Сохранить" Width="90" Height="34"
                        Background="#7B3FE4" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        Margin="8,0,0,0"
                        Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
