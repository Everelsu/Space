<UserControl x:Class="Space.MainProject"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,18,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page header -->
        <Grid Grid.Row="0" Margin="0,0,0,2">
            <StackPanel>
                <TextBlock Text="Проекты" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="Управление проектами компании" Style="{StaticResource PageSubtitleStyle}"/>
            </StackPanel>
            <TextBlock x:Name="CountLabel" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Foreground="#4B5563" FontSize="12" Margin="0,0,0,4"/>
        </Grid>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="0,12,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Style="{StaticResource SearchBoxStyle}"
                     Text="🔍  Поиск..." GotFocus="Search_GotFocus" LostFocus="Search_LostFocus"
                     TextChanged="Search_TextChanged"/>
            <ComboBox Grid.Column="2" x:Name="FilterStatus" Height="36"
                      Style="{StaticResource FormComboStyle}" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="Все статусы" Tag="" IsSelected="True"/>
                <ComboBoxItem Content="Активен"     Tag="active"/>
                <ComboBoxItem Content="Закрыт"      Tag="closed"/>
            </ComboBox>
            <Button Grid.Column="4" Content="+ Добавить" Style="{StaticResource PrimaryBtnStyle}"
                    Click="AddBtn_Click"/>
        </Grid>

        <!-- Add / Edit form -->
        <Border Grid.Row="2" x:Name="AddPanel" Visibility="Collapsed"
                Background="#1E293B" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="FormTitle" Text="Новый проект" Foreground="White" FontSize="13"
                           FontWeight="SemiBold" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox  Grid.Column="0" x:Name="AddName"     Style="{StaticResource FormInputStyle}" Tag="Название"/>
                    <TextBox  Grid.Column="2" x:Name="AddStart"    Style="{StaticResource FormInputStyle}" Tag="Начало (дд.мм.гггг)"/>
                    <TextBox  Grid.Column="4" x:Name="AddDeadline" Style="{StaticResource FormInputStyle}" Tag="Дедлайн (дд.мм.гггг)"/>
                    <ComboBox Grid.Column="6" x:Name="AddStatus"   Style="{StaticResource FormComboStyle}">
                        <ComboBoxItem Content="Активен" Tag="active" IsSelected="True"/>
                        <ComboBoxItem Content="Закрыт"  Tag="closed"/>
                    </ComboBox>
                    <Button Grid.Column="8" x:Name="SaveBtn" Content="Сохранить"
                            Style="{StaticResource PrimaryBtnStyle}" Click="SaveAdd_Click"/>
                </Grid>
                <TextBlock x:Name="AddError" Foreground="#F87171" FontSize="11"
                           Margin="0,6,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- DataGrid -->
        <DataGrid Grid.Row="3" x:Name="Grid" Style="{StaticResource GridStyle}"
                  ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                  CellStyle="{StaticResource GridCellStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"       Binding="{Binding Id}"          Width="45"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}"         Width="*"/>
                <DataGridTextColumn Header="Начало"   Binding="{Binding StartDate}"    Width="95"/>
                <DataGridTextColumn Header="Дедлайн"  Binding="{Binding Deadline}"     Width="95"/>
                <DataGridTextColumn Header="Статус"   Binding="{Binding StatusLabel}"  Width="85"/>
                <DataGridTextColumn Header="Менеджер" Binding="{Binding Manager}"      Width="155"/>
                <DataGridTemplateColumn Header="Действия" Width="155">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="✏ Изменить" Style="{StaticResource EditBtnStyle}"
                                        Tag="{Binding Id}" Click="Edit_Click" Margin="0,0,4,0"/>
                                <Button Content="Удалить" Style="{StaticResource DangerBtnStyle}"
                                        Tag="{Binding Id}" Click="Delete_Click"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
