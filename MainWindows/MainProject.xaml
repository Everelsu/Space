<UserControl x:Class="Space.MainProject"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,18,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page header -->
        <Grid Grid.Row="0" Margin="0,0,0,2">
            <StackPanel>
                <TextBlock Text="Проекты" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="Управление проектами компании" Style="{StaticResource PageSubtitleStyle}"/>
            </StackPanel>
            <TextBlock x:Name="CountLabel" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Foreground="#4B5563" FontSize="12" Margin="0,0,0,4"/>
        </Grid>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="0,12,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Style="{StaticResource SearchBoxStyle}"
                     Text="🔍  Поиск..." GotFocus="Search_GotFocus" LostFocus="Search_LostFocus"
                     TextChanged="Search_TextChanged"/>
            <ComboBox Grid.Column="2" x:Name="FilterStatus" Height="36"
                      Style="{StaticResource FormComboStyle}" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="Все статусы" Tag="" IsSelected="True"/>
                <ComboBoxItem Content="Активен"     Tag="active"/>
                <ComboBoxItem Content="Закрыт"      Tag="closed"/>
            </ComboBox>
            <Button Grid.Column="4" x:Name="AddBtn" Content="+ Добавить" Style="{StaticResource PrimaryBtnStyle}"
                    Click="AddBtn_Click"/>
        </Grid>

        <!-- DataGrid -->
        <DataGrid Grid.Row="2" x:Name="Grid" Style="{StaticResource GridStyle}"
                  ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                  CellStyle="{StaticResource GridCellStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"       Binding="{Binding Id}"          Width="50"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}"         Width="280"/>
                <DataGridTextColumn Header="Начало"   Binding="{Binding StartDate}"    Width="100"/>
                <DataGridTextColumn Header="Дедлайн"  Binding="{Binding Deadline}"     Width="100"/>
                <DataGridTextColumn Header="Статус"   Binding="{Binding StatusLabel}"  Width="90"/>
                <DataGridTextColumn Header="Менеджер" Binding="{Binding Manager}"      Width="180"/>
                <DataGridTemplateColumn x:Name="ColActions" Header="Действия" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="✏ Изменить" Style="{StaticResource EditBtnStyle}"
                                        Tag="{Binding Id}" Click="Edit_Click" Margin="0,0,4,0"/>
                                <Button Content="Удалить" Style="{StaticResource DangerBtnStyle}"
                                        Tag="{Binding Id}" Click="Delete_Click"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
