<Window x:Class="Space.Autorisation"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpaceZ Login"
        Height="450" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A">

    <Window.Resources>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#7B3FE4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#9D5CFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#7B3FE4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Height" Value="40"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#7B3FE4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Height" Value="40"/>
        </Style>

    </Window.Resources>

    <Grid>

        <Image Source="/Assets/Z.png" HorizontalAlignment="Left" VerticalAlignment="Top" Height="50" Width="120" Margin="160,10,0,0"/>

        <Border Width="300"
                Padding="20"
                CornerRadius="12"
                Background="#111827"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>

                <TextBlock Text="SpaceZ"
                           FontSize="26"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <TextBlock Text="Логин"
                           Foreground="#9CA3AF"
                           Margin="0,5"/>
                <TextBox x:Name="LoginBox"/>

                <TextBlock Text="Пароль"
                           Foreground="#9CA3AF"
                           Margin="0,10,0,5"/>
                <PasswordBox x:Name="PasswordBox"/>

                <Button Content="Войти"
                        Margin="0,20,0,0"
                        Click="Button_Click"/>

            </StackPanel>
        </Border>

    </Grid>
</Window>