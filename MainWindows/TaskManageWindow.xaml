<UserControl x:Class="Space.TaskManageWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,18,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,2">
            <StackPanel>
                <TextBlock Text="Задания" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="Задачи по проектам и исполнители" Style="{StaticResource PageSubtitleStyle}"/>
            </StackPanel>
            <TextBlock x:Name="CountLabel" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Foreground="#4B5563" FontSize="12" Margin="0,0,0,4"/>
        </Grid>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="0,12,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Style="{StaticResource SearchBoxStyle}"
                     Text="🔍  Поиск..." GotFocus="Search_GotFocus" LostFocus="Search_LostFocus"
                     TextChanged="Search_TextChanged"/>
            <ComboBox Grid.Column="2" x:Name="FilterStatus" Height="36"
                      Style="{StaticResource FormComboStyle}" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="Все статусы"  Tag="" IsSelected="True"/>
                <ComboBoxItem Content="Открыта"      Tag="open"/>
                <ComboBoxItem Content="В работе"     Tag="in_progress"/>
                <ComboBoxItem Content="Тестирование" Tag="testing"/>
                <ComboBoxItem Content="Закрыта"      Tag="closed"/>
            </ComboBox>
            <ComboBox Grid.Column="4" x:Name="FilterPriority" Height="36"
                      Style="{StaticResource FormComboStyle}" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="Все приоритеты" Tag="" IsSelected="True"/>
                <ComboBoxItem Content="Критичный"      Tag="critical"/>
                <ComboBoxItem Content="Высокий"        Tag="high"/>
                <ComboBoxItem Content="Средний"        Tag="medium"/>
                <ComboBoxItem Content="Низкий"         Tag="low"/>
            </ComboBox>
            <Button Grid.Column="6" x:Name="AddBtn" Content="+ Добавить" Style="{StaticResource PrimaryBtnStyle}"
                    Click="AddBtn_Click"/>
        </Grid>
        
        <DataGrid Grid.Row="2" x:Name="Grid" Style="{StaticResource GridStyle}"
                  ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                  CellStyle="{StaticResource GridCellStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"          Binding="{Binding Id}"            Width="45"/>
                <DataGridTextColumn Header="Задача"      Binding="{Binding Title}"          Width="*"/>
                <DataGridTextColumn Header="Проект"      Binding="{Binding Project}"        Width="110"/>
                <DataGridTextColumn Header="Исполнитель" Binding="{Binding Assignee}"       Width="120"/>
                <DataGridTextColumn Header="Приоритет"   Binding="{Binding PriorityLabel}"  Width="80"/>
                <DataGridTextColumn Header="Статус"      Binding="{Binding StatusLabel}"    Width="75"/>
                <DataGridTextColumn Header="Дедлайн"     Binding="{Binding Deadline}"       Width="80"/>
                <DataGridTemplateColumn x:Name="ColTimer" Header="" Width="SizeToCells">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="▶" Tag="{Binding Id}" Click="StartTimer_Click" Padding="8,4">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource EditBtnStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTimerActive}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="⏹" Tag="{Binding Id}" Click="StopTimer_Click" Padding="8,4">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource DangerBtnStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTimerActive}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <DataGridTemplateColumn x:Name="ColAdvanceDev" Header="Статус" Width="SizeToCells">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="{Binding NextStatusLabel}" Tag="{Binding Id}"
                                    Click="Advance_Click" Padding="8,4">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource EditBtnStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanAdvance}" Value="False">
                                                <Setter Property="Visibility" Value="Hidden"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn x:Name="ColAdvanceTester" Header="Статус" Width="SizeToCells">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Закрыть" Tag="{Binding Id}" Click="Advance_Click" Padding="8,4">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource EditBtnStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanAdvanceTester}" Value="False">
                                                <Setter Property="Visibility" Value="Hidden"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn x:Name="ColActions" Header="Действия" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="✏ Изменить" Style="{StaticResource EditBtnStyle}"
                                        Tag="{Binding Id}" Click="Edit_Click" Margin="0,0,4,0"/>
                                <Button Content="Удалить" Style="{StaticResource DangerBtnStyle}"
                                        Tag="{Binding Id}" Click="Delete_Click"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
