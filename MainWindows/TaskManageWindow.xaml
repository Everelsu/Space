<UserControl x:Class="Space.TaskManageWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,18,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page header -->
        <Grid Grid.Row="0" Margin="0,0,0,2">
            <StackPanel>
                <TextBlock Text="Задания" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="Задачи по проектам и исполнители" Style="{StaticResource PageSubtitleStyle}"/>
            </StackPanel>
            <TextBlock x:Name="CountLabel" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Foreground="#4B5563" FontSize="12" Margin="0,0,0,4"/>
        </Grid>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="0,12,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Style="{StaticResource SearchBoxStyle}"
                     Text="🔍  Поиск..." GotFocus="Search_GotFocus" LostFocus="Search_LostFocus"
                     TextChanged="Search_TextChanged"/>
            <ComboBox Grid.Column="2" x:Name="FilterStatus" Height="36"
                      Style="{StaticResource FormComboStyle}" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="Все статусы"  Tag="" IsSelected="True"/>
                <ComboBoxItem Content="Открыта"      Tag="open"/>
                <ComboBoxItem Content="В работе"     Tag="in_progress"/>
                <ComboBoxItem Content="Тестирование" Tag="testing"/>
                <ComboBoxItem Content="Закрыта"      Tag="closed"/>
            </ComboBox>
            <ComboBox Grid.Column="4" x:Name="FilterPriority" Height="36"
                      Style="{StaticResource FormComboStyle}" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="Все приоритеты" Tag="" IsSelected="True"/>
                <ComboBoxItem Content="Критичный"      Tag="critical"/>
                <ComboBoxItem Content="Высокий"        Tag="high"/>
                <ComboBoxItem Content="Средний"        Tag="medium"/>
                <ComboBoxItem Content="Низкий"         Tag="low"/>
            </ComboBox>
            <Button Grid.Column="6" x:Name="AddBtn" Content="+ Добавить" Style="{StaticResource PrimaryBtnStyle}"
                    Click="AddBtn_Click"/>
        </Grid>

        <!-- Timer banner -->
        <Border Grid.Row="2" x:Name="TimerBanner" Visibility="Collapsed"
                Background="#0F2A1E" BorderBrush="#22C55E" BorderThickness="1"
                CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Pulse dot -->
                <Ellipse Width="10" Height="10" Fill="#22C55E" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <!-- Task info -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Идёт работа:" Foreground="#86EFAC" FontSize="11"/>
                    <TextBlock x:Name="BannerTask" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                </StackPanel>
                <!-- Elapsed clock -->
                <TextBlock Grid.Column="2" x:Name="BannerTime"
                           Foreground="#22C55E" FontSize="22" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,16,0"
                           FontFamily="Consolas"/>
                <!-- Stop button -->
                <Button Grid.Column="3" Content="⏹  Остановить" Style="{StaticResource DangerBtnStyle}"
                        Click="StopTimer_Click" Padding="14,0"/>
            </Grid>
        </Border>

        <!-- DataGrid -->
        <DataGrid Grid.Row="3" x:Name="Grid" Style="{StaticResource GridStyle}"
                  ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                  CellStyle="{StaticResource GridCellStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"          Binding="{Binding Id}"            Width="50"/>
                <DataGridTextColumn Header="Задача"      Binding="{Binding Title}"          Width="280"/>
                <DataGridTextColumn Header="Проект"      Binding="{Binding Project}"        Width="130"/>
                <DataGridTextColumn Header="Исполнитель" Binding="{Binding Assignee}"       Width="140"/>
                <DataGridTextColumn Header="Приоритет"   Binding="{Binding PriorityLabel}"  Width="90"/>
                <DataGridTextColumn Header="Статус"      Binding="{Binding StatusLabel}"    Width="85"/>
                <DataGridTextColumn Header="Дедлайн"     Binding="{Binding Deadline}"       Width="90"/>
                <!-- ▶ Timer: admin + developer only -->
                <DataGridTemplateColumn x:Name="ColTimer" Header="" Width="SizeToCells">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="▶" Style="{StaticResource EditBtnStyle}"
                                    Tag="{Binding Id}" Click="StartTimer_Click"
                                    Padding="8,4" ToolTip="Начать работу над задачей"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Advance status: admin + developer (all non-closed tasks) -->
                <DataGridTemplateColumn x:Name="ColAdvanceDev" Header="Статус" Width="SizeToCells">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="{Binding NextStatusLabel}" Tag="{Binding Id}"
                                    Click="Advance_Click" Padding="8,4">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource EditBtnStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanAdvance}" Value="False">
                                                <Setter Property="Visibility" Value="Hidden"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Advance status: tester only (testing → closed) -->
                <DataGridTemplateColumn x:Name="ColAdvanceTester" Header="Статус" Width="SizeToCells">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Закрыть" Tag="{Binding Id}" Click="Advance_Click" Padding="8,4">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource EditBtnStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanAdvanceTester}" Value="False">
                                                <Setter Property="Visibility" Value="Hidden"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Edit: admin only -->
                <DataGridTemplateColumn x:Name="ColEdit" Header="" Width="SizeToCells">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="✏" Style="{StaticResource EditBtnStyle}"
                                    Tag="{Binding Id}" Click="Edit_Click"
                                    Padding="8,4"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Delete: admin only -->
                <DataGridTemplateColumn x:Name="ColDelete" Header="" Width="SizeToCells">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="✕" Style="{StaticResource DangerBtnStyle}"
                                    Tag="{Binding Id}" Click="Delete_Click"
                                    Padding="8,4"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
