<UserControl x:Class="Space.TeemProject"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,18,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page header -->
        <Grid Grid.Row="0" Margin="0,0,0,2">
            <StackPanel>
                <TextBlock Text="Команды" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="Структура команд и лиды проектов" Style="{StaticResource PageSubtitleStyle}"/>
            </StackPanel>
            <TextBlock x:Name="CountLabel" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Foreground="#4B5563" FontSize="12" Margin="0,0,0,4"/>
        </Grid>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="0,12,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Style="{StaticResource SearchBoxStyle}"
                     Text="🔍  Поиск..." GotFocus="Search_GotFocus" LostFocus="Search_LostFocus"
                     TextChanged="Search_TextChanged"/>
            <Button Grid.Column="1" x:Name="AddBtn" Content="+ Добавить" Style="{StaticResource PrimaryBtnStyle}"
                    Margin="10,0,0,0" Click="AddBtn_Click"/>
        </Grid>

        <!-- Add / Edit form -->
        <Border Grid.Row="2" x:Name="AddPanel" Visibility="Collapsed"
                Background="#1E293B" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="FormTitle" Text="Новая команда" Foreground="White" FontSize="13"
                           FontWeight="SemiBold" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="AddName" Style="{StaticResource FormInputStyle}" Tag="Название команды"/>
                    <Button  Grid.Column="2" x:Name="SaveBtn" Content="Сохранить"
                             Style="{StaticResource PrimaryBtnStyle}" Click="SaveAdd_Click"/>
                </Grid>
                <TextBlock x:Name="AddError" Foreground="#F87171" FontSize="11"
                           Margin="0,6,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- DataGrid -->
        <DataGrid Grid.Row="3" x:Name="Grid" Style="{StaticResource GridStyle}"
                  ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                  CellStyle="{StaticResource GridCellStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"         Binding="{Binding Id}"          Width="50"/>
                <DataGridTextColumn Header="Название"   Binding="{Binding Name}"         Width="280"/>
                <DataGridTextColumn Header="Лид"        Binding="{Binding Lead}"         Width="210"/>
                <DataGridTextColumn Header="Участников" Binding="{Binding MemberCount}"  Width="100"/>
                <DataGridTemplateColumn x:Name="ColActions" Header="Действия" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="✏ Изменить" Style="{StaticResource EditBtnStyle}"
                                        Tag="{Binding Id}" Click="Edit_Click" Margin="0,0,4,0"/>
                                <Button Content="Удалить" Style="{StaticResource DangerBtnStyle}"
                                        Tag="{Binding Id}" Click="Delete_Click"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
