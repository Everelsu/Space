<UserControl x:Class="Space.ReportWindows"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,18,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page header -->
        <Grid Grid.Row="0" Margin="0,0,0,2">
            <StackPanel>
                <TextBlock Text="Отчёты" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="Учёт рабочего времени по задачам" Style="{StaticResource PageSubtitleStyle}"/>
            </StackPanel>
            <TextBlock x:Name="CountLabel" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Foreground="#4B5563" FontSize="12" Margin="0,0,0,4"/>
        </Grid>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="0,12,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Style="{StaticResource SearchBoxStyle}"
                     Text="🔍  Поиск..." GotFocus="Search_GotFocus" LostFocus="Search_LostFocus"
                     TextChanged="Search_TextChanged"/>
            <Button Grid.Column="1" Content="+ Создать отчёт" Style="{StaticResource PrimaryBtnStyle}"
                    Margin="10,0,0,0" Click="AddBtn_Click"/>
        </Grid>

        <!-- DataGrid -->
        <DataGrid Grid.Row="2" x:Name="Grid" Style="{StaticResource GridStyle}"
                  ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                  CellStyle="{StaticResource GridCellStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"          Binding="{Binding Id}"       Width="50"/>
                <DataGridTextColumn Header="Задача"      Binding="{Binding Task}"      Width="280"/>
                <DataGridTextColumn Header="Работник"    Binding="{Binding Employee}"  Width="160"/>
                <DataGridTextColumn Header="Дата"        Binding="{Binding LogDate}"   Width="100"/>
                <DataGridTextColumn Header="Часов"       Binding="{Binding Hours}"     Width="70"/>
                <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}"   Width="200"/>
                <DataGridTemplateColumn x:Name="ColActions" Header="Действия" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="✏ Изменить" Style="{StaticResource EditBtnStyle}"
                                        Tag="{Binding Id}" Click="Edit_Click" Margin="0,0,4,0"/>
                                <Button Content="Удалить" Style="{StaticResource DangerBtnStyle}"
                                        Tag="{Binding Id}" Click="Delete_Click"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
