<UserControl x:Class="Space.ReportWindows"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,18,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page header -->
        <Grid Grid.Row="0" Margin="0,0,0,2">
            <StackPanel>
                <TextBlock Text="Отчёты" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="Учёт рабочего времени по задачам" Style="{StaticResource PageSubtitleStyle}"/>
            </StackPanel>
            <TextBlock x:Name="CountLabel" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Foreground="#4B5563" FontSize="12" Margin="0,0,0,4"/>
        </Grid>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="0,12,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Style="{StaticResource SearchBoxStyle}"
                     Text="🔍  Поиск..." GotFocus="Search_GotFocus" LostFocus="Search_LostFocus"
                     TextChanged="Search_TextChanged"/>
            <Button Grid.Column="1" Content="+ Создать отчёт" Style="{StaticResource PrimaryBtnStyle}"
                    Margin="10,0,0,0" Click="AddBtn_Click"/>
        </Grid>

        <!-- Add / Edit form -->
        <Border Grid.Row="2" x:Name="AddPanel" Visibility="Collapsed"
                Background="#1E293B" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="FormTitle" Text="Новый отчёт" Foreground="White" FontSize="13"
                           FontWeight="SemiBold" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" x:Name="AddTask"     Style="{StaticResource FormComboStyle}" DisplayMemberPath="Name"/>
                    <ComboBox Grid.Column="2" x:Name="AddEmployee" Style="{StaticResource FormComboStyle}" DisplayMemberPath="Name"/>
                    <TextBox  Grid.Column="4" x:Name="AddHours"    Style="{StaticResource FormInputStyle}" Tag="Часы" Text="1"/>
                    <TextBox  Grid.Column="6" x:Name="AddDate"     Style="{StaticResource FormInputStyle}" Tag="дд.мм.гггг"/>
                    <Button   Grid.Column="8" x:Name="SaveBtn" Content="Сохранить"
                              Style="{StaticResource PrimaryBtnStyle}" Click="SaveAdd_Click"/>
                </Grid>
                <TextBox x:Name="AddComment" Style="{StaticResource FormInputStyle}"
                         Tag="Комментарий" Margin="0,8,0,0" Height="36"/>
                <TextBlock x:Name="AddError" Foreground="#F87171" FontSize="11"
                           Margin="0,6,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- DataGrid -->
        <DataGrid Grid.Row="3" x:Name="Grid" Style="{StaticResource GridStyle}"
                  ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                  CellStyle="{StaticResource GridCellStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"          Binding="{Binding Id}"       Width="45"/>
                <DataGridTextColumn Header="Задача"      Binding="{Binding Task}"      Width="*"/>
                <DataGridTextColumn Header="Работник"    Binding="{Binding Employee}"  Width="145"/>
                <DataGridTextColumn Header="Дата"        Binding="{Binding LogDate}"   Width="90"/>
                <DataGridTextColumn Header="Часов"       Binding="{Binding Hours}"     Width="60"/>
                <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}"   Width="175"/>
                <DataGridTemplateColumn Header="Действия" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="✏ Изменить" Style="{StaticResource EditBtnStyle}"
                                        Tag="{Binding Id}" Click="Edit_Click" Margin="0,0,4,0"/>
                                <Button Content="Удалить" Style="{StaticResource DangerBtnStyle}"
                                        Tag="{Binding Id}" Click="Delete_Click"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
