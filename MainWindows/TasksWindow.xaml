<UserControl x:Class="Space.TasksWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,18,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page header -->
        <Grid Grid.Row="0" Margin="0,0,0,2">
            <StackPanel>
                <TextBlock Text="Работники" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="Список сотрудников и управление доступом" Style="{StaticResource PageSubtitleStyle}"/>
            </StackPanel>
            <TextBlock x:Name="CountLabel" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Foreground="#4B5563" FontSize="12" Margin="0,0,0,4"/>
        </Grid>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="0,12,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Style="{StaticResource SearchBoxStyle}"
                     Text="🔍  Поиск..." GotFocus="Search_GotFocus" LostFocus="Search_LostFocus"
                     TextChanged="Search_TextChanged"/>
            <ComboBox Grid.Column="2" x:Name="FilterRole" Height="36"
                      Style="{StaticResource FormComboStyle}" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="Все роли"  Tag="" IsSelected="True"/>
                <ComboBoxItem Content="Разработчик" Tag="developer"/>
                <ComboBoxItem Content="Тестировщик" Tag="tester"/>
                <ComboBoxItem Content="Менеджер"    Tag="manager"/>
            </ComboBox>
            <Button Grid.Column="4" x:Name="AddBtn" Content="+ Добавить" Style="{StaticResource PrimaryBtnStyle}"
                    Click="AddBtn_Click"/>
        </Grid>

        <!-- Add / Edit form -->
        <Border Grid.Row="2" x:Name="AddPanel" Visibility="Collapsed"
                Background="#1E293B" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="FormTitle" Text="Новый работник" Foreground="White" FontSize="13"
                           FontWeight="SemiBold" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>
                    <TextBox  Grid.Column="0" x:Name="AddFullName" Style="{StaticResource FormInputStyle}" Tag="Имя Фамилия"/>
                    <TextBox  Grid.Column="2" x:Name="AddEmail"    Style="{StaticResource FormInputStyle}" Tag="Email"/>
                    <TextBox  Grid.Column="4" x:Name="AddPosition" Style="{StaticResource FormInputStyle}" Tag="Должность"/>
                    <ComboBox Grid.Column="6" x:Name="AddRole"     Style="{StaticResource FormComboStyle}">
                        <ComboBoxItem Content="Разработчик" Tag="developer" IsSelected="True"/>
                        <ComboBoxItem Content="Тестировщик" Tag="tester"/>
                        <ComboBoxItem Content="Менеджер"    Tag="manager"/>
                    </ComboBox>
                </Grid>
                <Grid x:Name="LoginRow" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="AddUsername" Style="{StaticResource FormInputStyle}" Tag="Логин"/>
                    <TextBox Grid.Column="2" x:Name="AddPassword" Style="{StaticResource FormInputStyle}" Tag="Пароль"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Right">
                    <TextBlock x:Name="AddError" Foreground="#F87171" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,10,0" Visibility="Collapsed"/>
                    <Button x:Name="SaveBtn" Content="Сохранить"
                            Style="{StaticResource PrimaryBtnStyle}" Click="SaveAdd_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- DataGrid -->
        <DataGrid Grid.Row="3" x:Name="Grid" Style="{StaticResource GridStyle}"
                  ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                  CellStyle="{StaticResource GridCellStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"        Binding="{Binding Id}"        Width="50"/>
                <DataGridTextColumn Header="Имя"       Binding="{Binding FullName}"   Width="200"/>
                <DataGridTextColumn Header="Должность" Binding="{Binding Position}"   Width="130"/>
                <DataGridTextColumn Header="Email"     Binding="{Binding Email}"      Width="160"/>
                <DataGridTextColumn Header="Команда"   Binding="{Binding Team}"       Width="100"/>
                <DataGridTextColumn Header="Логин"     Binding="{Binding Username}"   Width="100"/>
                <DataGridTextColumn Header="Роль"      Binding="{Binding RoleLabel}"  Width="110"/>
                <DataGridTemplateColumn x:Name="ColActions" Header="Действия" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="✏ Изменить" Style="{StaticResource EditBtnStyle}"
                                        Tag="{Binding Id}" Click="Edit_Click" Margin="0,0,4,0"/>
                                <Button Content="Удалить" Style="{StaticResource DangerBtnStyle}"
                                        Tag="{Binding Id}" Click="Delete_Click"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
