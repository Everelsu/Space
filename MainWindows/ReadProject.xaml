<Window x:Class="Space.ReadProject"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="О разработчике"
        Width="400" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="#0F172A" CornerRadius="12" Margin="8">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="0" Opacity="0.65"/>
        </Border.Effect>
        <StackPanel>

            <!-- Title bar -->
            <Grid Height="52" MouseLeftButtonDown="TitleBar_MouseDown">
                <TextBlock Text="О разработчике" Foreground="White"
                           FontSize="15" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="22,0,0,0"/>
                <Button Content="✕" Style="{StaticResource TitleBtnStyle}"
                        HorizontalAlignment="Right" Margin="0,0,10,0" Click="Close_Click"/>
            </Grid>

            <Rectangle Height="1" Fill="#1E293B"/>

            <!-- Content -->
            <StackPanel Margin="22,20,22,20">

                <TextBlock Text="Система управления IT-проектами"
                           Foreground="#6B7280" FontSize="12" Margin="0,0,0,16"/>

                <TextBlock Text="Разработчики" Foreground="#9CA3AF"
                           FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>

                <TextBlock Foreground="White" FontSize="13" Margin="0,0,0,4">
                    Чупошев Даниил  —  Дагбаев Егор
                </TextBlock>

                <TextBlock Text="Группа ИСиП-23-1п"
                           Foreground="#6B7280" FontSize="12" Margin="0,0,0,20"/>

                <Rectangle Height="1" Fill="#1E293B" Margin="0,0,0,16"/>

                <TextBlock Text="Репозиторий проекта" Foreground="#9CA3AF"
                           FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>

                <Button x:Name="GithubBtn"
                        Content="github.com/Everelsu/Space"
                        HorizontalAlignment="Left"
                        Style="{StaticResource SecondaryBtnStyle}"
                        Click="GitHub_Click"/>

            </StackPanel>

            <Rectangle Height="1" Fill="#1E293B"/>

            <Grid Margin="22,14,22,16">
                <Button Content="Закрыть" HorizontalAlignment="Right" Width="110"
                        Style="{StaticResource PrimaryBtnStyle}" Click="Close_Click"/>
            </Grid>

        </StackPanel>
    </Border>
</Window>
