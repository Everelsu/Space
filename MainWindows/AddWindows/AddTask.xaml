<Window x:Class="Space.AddWindows.AddTask"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Задача"
        Width="500" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="#0F172A" CornerRadius="12" Margin="8">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="0" Opacity="0.65"/>
        </Border.Effect>
        <StackPanel>

            <!-- Title bar -->
            <Grid Height="52" MouseLeftButtonDown="TitleBar_MouseDown">
                <TextBlock x:Name="DialogTitle" Text="Новая задача"
                           Foreground="White" FontSize="15" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="22,0,0,0"/>
                <Button Content="✕" Style="{StaticResource TitleBtnStyle}"
                        HorizontalAlignment="Right" Margin="0,0,10,0" Click="Cancel_Click"/>
            </Grid>

            <Rectangle Height="1" Fill="#1E293B"/>

            <!-- Fields -->
            <StackPanel Margin="22,18,22,18">

                <TextBlock Text="Название задачи *" Foreground="#9CA3AF" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtTitle" Style="{StaticResource FormInputStyle}"/>

                <TextBlock Text="Проект *" Foreground="#9CA3AF" FontSize="11" FontWeight="SemiBold" Margin="0,14,0,6"/>
                <ComboBox x:Name="CmbProject" Style="{StaticResource FormComboStyle}" DisplayMemberPath="Name"/>

                <TextBlock Text="Исполнитель" Foreground="#9CA3AF" FontSize="11" FontWeight="SemiBold" Margin="0,14,0,6"/>
                <ComboBox x:Name="CmbAssignee" Style="{StaticResource FormComboStyle}" DisplayMemberPath="Name"/>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="145"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Приоритет" Foreground="#9CA3AF" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbPriority" Style="{StaticResource FormComboStyle}">
                            <ComboBoxItem Content="Низкий"    Tag="low"      IsSelected="True"/>
                            <ComboBoxItem Content="Средний"   Tag="medium"/>
                            <ComboBoxItem Content="Высокий"   Tag="high"/>
                            <ComboBoxItem Content="Критичный" Tag="critical"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Статус" Foreground="#9CA3AF" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbStatus" Style="{StaticResource FormComboStyle}">
                            <ComboBoxItem Content="Открыта"      Tag="open"        IsSelected="True"/>
                            <ComboBoxItem Content="В работе"     Tag="in_progress"/>
                            <ComboBoxItem Content="Тестирование" Tag="testing"/>
                            <ComboBoxItem Content="Закрыта"      Tag="closed"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Дедлайн (дд.мм.гггг)" Foreground="#9CA3AF" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtDeadline" Style="{StaticResource FormInputStyle}"/>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="ErrorText" Foreground="#F87171" FontSize="11"
                           Margin="0,12,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
            </StackPanel>

            <Rectangle Height="1" Fill="#1E293B"/>

            <!-- Buttons -->
            <Grid Margin="22,14,22,18">
                <Button Content="Отмена" HorizontalAlignment="Left" Width="110"
                        Style="{StaticResource SecondaryBtnStyle}" Click="Cancel_Click"/>
                <Button x:Name="SaveBtn" Content="Сохранить" HorizontalAlignment="Right" Width="130"
                        Style="{StaticResource PrimaryBtnStyle}" Click="Save_Click"/>
            </Grid>

        </StackPanel>
    </Border>
</Window>
