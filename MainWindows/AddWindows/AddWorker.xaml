<Window x:Class="Space.AddWindows.AddWorker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сотрудник" Icon="/Assets/Z.png"
        Width="520" SizeToContent="Height"
        Loaded="Window_Loaded"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="#252c33" CornerRadius="12" Margin="8">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="0" Opacity="0.65"/>
        </Border.Effect>
        <StackPanel>

            <Grid Height="52" MouseLeftButtonDown="TitleBar_MouseDown">
                <TextBlock x:Name="DialogTitle" Text="Новый сотрудник"
                           Foreground="White" FontSize="15" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="22,0,0,0"/>
                <Button Content="✕" Style="{StaticResource TitleBtnStyle}"
                        HorizontalAlignment="Right" Margin="0,0,10,0" Click="Cancel_Click"/>
            </Grid>

            <Rectangle Height="1" Fill="#1E293B"/>
            <StackPanel Margin="22,18,22,18">

                <TextBlock Text="Полное имя *" Foreground="#9CA3AF" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtFullName" Style="{StaticResource FormInputStyle}"/>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Email" Foreground="#9CA3AF" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtEmail" Style="{StaticResource FormInputStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Должность" Foreground="#9CA3AF" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtPosition" Style="{StaticResource FormInputStyle}"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Роль" Foreground="#9CA3AF" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbRole" Style="{StaticResource FormComboStyle}">
                            <ComboBoxItem Content="Разработчик"   Tag="developer" IsSelected="True"/>
                            <ComboBoxItem Content="Тестировщик"   Tag="tester"/>
                            <ComboBoxItem Content="Менеджер"      Tag="manager"/>
                            <ComboBoxItem Content="Администратор" Tag="admin"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Команда" Foreground="#9CA3AF" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbTeam" Style="{StaticResource FormComboStyle}"
                                  DisplayMemberPath="Name"/>
                    </StackPanel>
                </Grid>

                <Border x:Name="LoginSection" Background="#1e2429" CornerRadius="8"
                        Padding="14,12" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="ДАННЫЕ ДЛЯ ВХОДА" Foreground="#4B5563"
                                   FontSize="10" FontWeight="Bold" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Логин *" Foreground="#9CA3AF" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBox x:Name="TxtUsername" Style="{StaticResource FormInputStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Пароль *" Foreground="#9CA3AF" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBox x:Name="TxtPassword" Style="{StaticResource FormInputStyle}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="ErrorText" Foreground="#F87171" FontSize="11"
                           Margin="0,12,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
            </StackPanel>

            <Rectangle Height="1" Fill="#1E293B"/>

            <Grid Margin="22,14,22,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="177*"/>
                    <ColumnDefinition Width="283*"/>
                </Grid.ColumnDefinitions>
                <Button Content="Отмена" HorizontalAlignment="Left" Width="110"
                        Style="{StaticResource SecondaryBtnStyle}" Click="Cancel_Click"/>
                <Button x:Name="SaveBtn" Content="Сохранить" HorizontalAlignment="Left" Width="130"
                        Style="{StaticResource PrimaryBtnStyle}" Click="Save_Click" Grid.Column="1" Margin="153,0,0,0"/>
            </Grid>

        </StackPanel>
    </Border>
</Window>
