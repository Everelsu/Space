<ui:FluentWindow x:Class="Space.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="SpaceZ"
        Width="420" Height="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="SpaceZ"/>

        <Grid Grid.Row="1">
            <Border MaxWidth="320"
                    VerticalAlignment="Center"
                    Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="12"
                    Padding="32">

                <StackPanel>
                    <ui:SymbolIcon Symbol="ClipboardTask24"
                                   FontSize="48"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,12"/>

                    <TextBlock Text="SpaceZ"
                               FontSize="22"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,4"/>

                    <TextBlock Text="Войдите в свой аккаунт"
                               FontSize="13"
                               Opacity="0.6"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,28"/>

                    <TextBlock Text="Логин" FontSize="12" Margin="0,0,0,4"/>
                    <ui:TextBox x:Name="UsernameInput"
                                PlaceholderText="Введите логин"
                                Icon="{ui:SymbolIcon Person24}"
                                Margin="0,0,0,14"/>

                    <TextBlock Text="Пароль" FontSize="12" Margin="0,0,0,4"/>
                    <ui:PasswordBox x:Name="PasswordInput"
                                    PlaceholderText="Введите пароль"
                                    Icon="{ui:SymbolIcon LockClosed24}"
                                    Margin="0,0,0,8"/>

                    <TextBlock x:Name="ErrorText"
                               Foreground="{ui:ThemeResource SystemFillColorCriticalBrush}"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,4,0,12"
                               Visibility="Collapsed"/>

                    <ui:Button x:Name="LoginButton"
                               Content="Войти"
                               Appearance="Primary"
                               HorizontalAlignment="Stretch"
                               Height="40"
                               FontSize="14"
                               Click="LoginButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
