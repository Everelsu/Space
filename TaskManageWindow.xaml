<Window x:Class="Space.TaskManageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpaceZ — Задания" Height="650" Width="1100"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Border Background="#111827" CornerRadius="12" Margin="8">
        <Border.Effect><DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.5"/></Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Background="#0B1120" MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0" Width="92">
                    <TextBlock Text="Space" FontSize="16" FontWeight="Bold" Foreground="White"
                               VerticalAlignment="Center" Margin="-10,0,10,0"/>
                    <Image Source="/Assets/Z.png" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top"
                           Margin="0,-2,-28,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button Content="─" Style="{StaticResource TitleBtnStyle}" Click="Minimize_Click"/>
                    <Button Content="✕" Style="{StaticResource TitleBtnStyle}" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- Body -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="195"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0" Background="#0B1120" CornerRadius="0,0,0,12">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Margin="8,0,8,12">
                            <Separator Background="#1E293B" Margin="4,0,4,8" Height="1"/>
                            <Button Content="⬅  Выход" Style="{StaticResource NavBtnStyle}"
                                    Foreground="#EF4444" Click="Exit_Click"/>
                        </StackPanel>
                        <Border DockPanel.Dock="Top" Background="#0D1629" Margin="8,12,8,4"
                                Padding="12,10" CornerRadius="8">
                            <StackPanel>
                                <TextBlock x:Name="SidebarRole"     Style="{StaticResource UserRoleStyle}"/>
                                <TextBlock x:Name="SidebarUsername" Style="{StaticResource UserNameStyle}"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Margin="8,8,8,0">
                            <TextBlock Text="НАВИГАЦИЯ" Style="{StaticResource NavSectionLabel}"/>
                            <Button Content="📁  Проекты"   Style="{StaticResource NavBtnStyle}"    Click="NavProjects_Click"/>
                            <Button Content="👥  Работники" Style="{StaticResource NavBtnStyle}"    Click="NavEmployees_Click"/>
                            <Button Content="🏷  Команды"   Style="{StaticResource NavBtnStyle}"    Click="NavTeams_Click"/>
                            <Button Content="📋  Задания"   Style="{StaticResource NavBtnActiveStyle}"/>
                            <Button Content="📝  Отчёты"    Style="{StaticResource NavBtnStyle}"    Click="NavReports_Click"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Content -->
                <Grid Grid.Column="1" Margin="24,18,24,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Page header with counter -->
                    <Grid Grid.Row="0" Margin="0,0,0,2">
                        <StackPanel>
                            <TextBlock Text="Задания" Style="{StaticResource PageTitleStyle}"/>
                            <TextBlock Text="Задачи по проектам и исполнители" Style="{StaticResource PageSubtitleStyle}"/>
                        </StackPanel>
                        <TextBlock x:Name="CountLabel" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                   Foreground="#4B5563" FontSize="12" Margin="0,0,0,4"/>
                    </Grid>

                    <!-- Toolbar: Search + Filters + Add -->
                    <Grid Grid.Row="1" Margin="0,12,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" Style="{StaticResource SearchBoxStyle}"
                                 Text="🔍  Поиск..." GotFocus="Search_GotFocus" LostFocus="Search_LostFocus"
                                 TextChanged="Search_TextChanged"/>
                        <ComboBox Grid.Column="2" x:Name="FilterStatus" Height="36"
                                  Style="{StaticResource FormComboStyle}"
                                  SelectionChanged="Filter_Changed">
                            <ComboBoxItem Content="Все статусы"  Tag="" IsSelected="True"/>
                            <ComboBoxItem Content="Открыта"      Tag="open"/>
                            <ComboBoxItem Content="В работе"     Tag="in_progress"/>
                            <ComboBoxItem Content="Тестирование" Tag="testing"/>
                            <ComboBoxItem Content="Закрыта"      Tag="closed"/>
                        </ComboBox>
                        <ComboBox Grid.Column="4" x:Name="FilterPriority" Height="36"
                                  Style="{StaticResource FormComboStyle}"
                                  SelectionChanged="Filter_Changed">
                            <ComboBoxItem Content="Все приоритеты" Tag="" IsSelected="True"/>
                            <ComboBoxItem Content="Критичный"      Tag="critical"/>
                            <ComboBoxItem Content="Высокий"        Tag="high"/>
                            <ComboBoxItem Content="Средний"        Tag="medium"/>
                            <ComboBoxItem Content="Низкий"         Tag="low"/>
                        </ComboBox>
                        <Button Grid.Column="6" Content="+ Добавить" Style="{StaticResource PrimaryBtnStyle}"
                                Click="AddBtn_Click"/>
                    </Grid>

                    <!-- Add / Edit form -->
                    <Border Grid.Row="2" x:Name="AddPanel" Visibility="Collapsed"
                            Background="#1E293B" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock x:Name="FormTitle" Text="Новое задание" Foreground="White" FontSize="13"
                                       FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox  Grid.Column="0" x:Name="AddTitle"    Style="{StaticResource FormInputStyle}" Tag="Название задачи"/>
                                <ComboBox Grid.Column="2" x:Name="AddProject"  Style="{StaticResource FormComboStyle}" DisplayMemberPath="Name"/>
                                <ComboBox Grid.Column="4" x:Name="AddAssignee" Style="{StaticResource FormComboStyle}" DisplayMemberPath="Name"/>
                                <Button   Grid.Column="6" x:Name="SaveBtn" Content="Сохранить"
                                          Style="{StaticResource PrimaryBtnStyle}" Click="SaveAdd_Click"/>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="115"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" x:Name="AddPriority" Style="{StaticResource FormComboStyle}">
                                    <ComboBoxItem Content="Низкий"    Tag="low"      IsSelected="True"/>
                                    <ComboBoxItem Content="Средний"   Tag="medium"/>
                                    <ComboBoxItem Content="Высокий"   Tag="high"/>
                                    <ComboBoxItem Content="Критичный" Tag="critical"/>
                                </ComboBox>
                                <ComboBox Grid.Column="2" x:Name="AddStatus" Style="{StaticResource FormComboStyle}">
                                    <ComboBoxItem Content="Открыта"      Tag="open"        IsSelected="True"/>
                                    <ComboBoxItem Content="В работе"     Tag="in_progress"/>
                                    <ComboBoxItem Content="Тестирование" Tag="testing"/>
                                    <ComboBoxItem Content="Закрыта"      Tag="closed"/>
                                </ComboBox>
                                <TextBox Grid.Column="4" x:Name="AddDeadline" Style="{StaticResource FormInputStyle}" Tag="Дедлайн (дд.мм.гггг)"/>
                            </Grid>
                            <TextBlock x:Name="AddError" Foreground="#F87171" FontSize="11"
                                       Margin="0,6,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="3" x:Name="Grid" Style="{StaticResource GridStyle}"
                              ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                              CellStyle="{StaticResource GridCellStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"          Binding="{Binding Id}"            Width="40"/>
                            <DataGridTextColumn Header="Задача"      Binding="{Binding Title}"          Width="*"/>
                            <DataGridTextColumn Header="Проект"      Binding="{Binding Project}"        Width="120"/>
                            <DataGridTextColumn Header="Исполнитель" Binding="{Binding Assignee}"       Width="130"/>
                            <DataGridTextColumn Header="Приоритет"   Binding="{Binding PriorityLabel}"  Width="85"/>
                            <DataGridTextColumn Header="Статус"      Binding="{Binding StatusLabel}"    Width="80"/>
                            <DataGridTextColumn Header="Дедлайн"     Binding="{Binding Deadline}"       Width="80"/>
                            <DataGridTemplateColumn Header="Действия" Width="185">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <!-- Quick-advance (Linear-style: moves to next status) -->
                                            <Button Content="{Binding NextStatusLabel}"
                                                    Tag="{Binding Id}" Click="Advance_Click"
                                                    Margin="0,0,4,0" MinWidth="58">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource EditBtnStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CanAdvance}" Value="False">
                                                                <Setter Property="Visibility" Value="Hidden"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="✏" Style="{StaticResource EditBtnStyle}"
                                                    Tag="{Binding Id}" Click="Edit_Click"
                                                    Margin="0,0,4,0" Width="26" Padding="0"/>
                                            <Button Content="✕" Style="{StaticResource DangerBtnStyle}"
                                                    Tag="{Binding Id}" Click="Delete_Click"
                                                    Width="26" Padding="0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
