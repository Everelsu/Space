<Window x:Class="Space.MainProject"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Space"
        mc:Ignorable="d"
        Title="MainProject" Height="450" Width="800">

    <Window.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#111827"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FF3A4358"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="30"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#FF3A4358"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

    </Window.Resources>

    <Grid Background="#111827">
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200*"/>
            <ColumnDefinition Width="600*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Label Grid.Column="0" Grid.Row="0" HorizontalContentAlignment="Left" VerticalContentAlignment="Top">Space</Label>
            <Image Source="/Assets/Z.png" Margin="47,0,11,10" />

            <Button Grid.Row="1">Проект</Button>
            <Button Grid.Row="2">Работники</Button>
            <Button Grid.Row="3">Команды</Button>
            <Button Grid.Row="4">Отчеты</Button>
            
            <Button Background="Red" FontSize="10" Grid.Row="5" Margin="10,38,139,10" Click="Button_Click_1">Выход</Button>

        </Grid>

        <Grid Grid.Column="1">
            <DataGrid x:Name="myDataGrid" AutoGenerateColumns="True" />
        </Grid>

    </Grid>
</Window>
